  "status": "implemented_experimental",
  "runnable_with_current_cli": true,
  "calibrated": false,
  "units": "SI",
  "description": "An oversized finite plane compresses the whole nominal sensor footprint, then slides while compression is held. All recorded states must maintain macroscopic contact.",
