    ],
    "release": false,
    "allow_recorded_lift_off": false,
    "notes": [
      "Rigid specimen: the gel alone carries the load, so a confined-layer estimate puts the stack near 66 N/mm against about 20 N/mm for the rubber.",
      "Preload 0.03 mm, estimated near 2 N; the press then commands 2.5 N upward to 5 N so the handover moves the platen in the pressing direction whichever way the estimate errs.",
      "Control, not a dataset. A rigid smooth target is one exact quad with no internal boundaries, so it removes the faceted sliding surface, the specimen's near incompressibility and the contact pairing question at once.",
      "No release: it would need the travel it lifts from, which load control leaves as an outcome and nobody has measured for a rigid specimen.",
      "The slide accelerates to 5.278 mm/s over 0.2 s instead of stepping to speed, and the onset is stepped ten times finer. The slide still covers its declared 10 mm."
    ],
    "normal_force_target_n": 5.0,
    "travel_calibration": "Not needed: the press commands 5 N directly. The preload stays travel-driven because normal stiffness is zero before first touch, and the release is travel-driven because holding zero load cannot lift clear of the surface.",
    "transient": {
      "windows": [
        {
          "start_time_s": 3.0,
          "end_time_s": 3.2,
          "time_increment_s": 0.002,
          "sample_interval_s": 0.1,
          "inertia": false,
          "reason": "Slide onset. The first increment has to be small against the slip allowance, or every contact point crosses it together."
        }
      ]
    }
  },
  "contact_acceptance": {
    "scope": "all_recorded_frames_and_converged_substeps",
    "definition": "continuous_full_nominal_footprint_at_macroscopic_scale",
    "sensor_region": "whole_outer_sensor_surface_including_area_outside_camera_fov",
    "minimum_geometric_footprint_coverage_fraction": 1,
    "minimum_plane_edge_margin_m": 0.002,
    "use_deformed_sensor_coordinates": true,
    "macroscopic_contact_bins": {
      "size_xy_m": [
        0.001,
        0.001
      ],
      "coordinates": "sensor_material_xy",
      "clip_bins_at_sensor_boundary": true,
      "contact_measure": "positive_repulsive_normal_contact_force_integrated_in_each_bin",
      "minimum_bin_force_n": 1e-06,
      "required_active_bin_fraction": 1
    },
    "minimum_total_repulsive_normal_force_n": 0.01,
    "microscopic_asperity_gaps_allowed": true,
    "tangential_sliding_allowed": true,
    "permanent_bonding": false,
    "full_contact_enforcement": "reject_sequence_if_acceptance_fails; do_not_disable_separation",
    "initial_state_adjustment": "No silent preload increase or contact constraint change; revise the config if preload does not achieve acceptance.",
    "status": "requirements_only_not_verified_by_a_solve"
  },
  "discretization": {
    "gel_base_elements": [
      36,
      30,
      8
    ],
    "deformable_specimen_base_elements": [
      48,
      42,
      6
    ],
    "common_contact_surface_max_edge_m": 0.000125,
    "refined_depth_into_each_deformable_body_m": 0.0005,
    "maximum_element_growth_ratio": 1.3,
    "same_sensor_mesh_for_all_cases": true,
    "required_checks": [
      "surface_resolution",
      "through_thickness_convergence",
      "near_incompressible_locking",
      "contact_coverage"
    ],
    "note": "The default gel uses sensor.gel.elements (36 x 30 x 8). Set gel_mesh to refined to opt into the 0.125 mm whole-surface grid and graded depth. Object mesh resolution is independent. Fine texture accuracy requires a refinement comparison.",
    "object_mesh": {
      "default": "simplified",
      "deformable_max_edge_m": 0.0005,
      "smooth_rigid_target": "single_exact_quad",
      "rough_rigid_target": "retain_resolved_height_geometry",
      "note": "Object discretization is independent of the unchanged gel mesh. Use matched to compare against the original contact-matched solid grid."
    },
    "gel_mesh": "uniform"
  },
  "contact_numerics": {
    "formulation": "augmented_lagrange",
    "sliding": "finite",
    "separation": "allowed",
    "normal_stiffness_factor": 10,
    "tangential_stiffness_factor": 10,
    "penetration_tolerance_m": 1e-05,
    "elastic_slip_tolerance_m": 2.5e-05,
    "update_stiffness_each_iteration": true,
    "retain_history_during_slide": true,
    "stabilization_damping": {
      "normal_factor": 0.001,
      "tangential_factor": 0.001,
      "activation": "always"
    },
    "penetration_tolerance_note": "Penetration scales as 1/FKN: measured 26.4 um at FKN = 1, so FKN = 10 gives about 2.6 um, roughly 2% of the 150 um surface deformation the renderer depends on. The 10 um threshold then sits about four times above it, so augmentation rarely fires and the contact status stops chattering. A 1 um threshold with FKN = 1 forced augmentation every step: ANSYS's chattering level climbed 0 -> 12 over 370 um of slide, in four runs that otherwise differed in normal control, damping, inertia and friction law.",
    "tangential_pair_note": "The first slide step converged and was then thrown off ten times, the residual jumping up to 326x each time before it gave up. Augmented Lagrange updates its multipliers on a converged state, so repeated jumps mean the threshold is tighter than the penalty can hold. The normal direction can no longer be the cause - FTOLN is 10 um against 0.69 um of penetration - which leaves the tangential pair, untouched at FKT = 1 and SLTO = 2.5 um. ANSYS defaults SLTO to about 1% of the contact length, near 7 um here."
  },
  "solver": {
    "version": 252,
    "license_type": "ansys",
    "cores": 2,
    "gpu": true,
    "allow_unlisted_gpu": false,
    "require_gpu": true,
    "initial_substeps": 10,
    "maximum_substeps": 200,
    "iterations": 80,
    "newton_raphson": "unsymmetric",
    "force_tolerance": 0.005,
    "balance_tolerance": 0.02,
    "force_norm": 1,
    "analysis": "time_dependent_quasi_static",
    "large_deflection": true,
    "inertia": false,
    "maximum_time_increment_s": 0.01,
    "gpu_verification": "activation_and_positive_accelerated_work",
    "unsupported_gpu_formulation_policy": "stop_and_report; do_not_silently_change_material_or_formulation"
  },
  "dataset": {
    "sample_interval_s": 0.01,
    "record": [
