{
  "schema_version": 3,
  "config_kind": "contact_simulation",
  "name": "plane_rough_surface_press_slide",
  "calibrated": false,
  "setup": "suite.json",
  "object": {
    "geometry": {
      "shape": "plane",
      "width_m": 0.06,
      "length_m": 0.035,
      "thickness_m": 0.003
    },
    "material": {
      "case": "../materials/rigid.json"
    }
  },
  "surface": {
    "model": "sinusoidal_height_field",
    "coordinates": "specimen_material_xy",
    "height_m": "sum(amplitude_m * cos(2*pi*(x/wavelength_x_m + y/wavelength_y_m) + phase_rad)); omit_axis_term_when_wavelength_is_null",
    "modes": [
      {
        "amplitude_m": 2e-05,
        "wavelength_x_m": 0.0012,
        "wavelength_y_m": null,
        "phase_rad": 0
      },
      {
        "amplitude_m": 1e-05,
        "wavelength_x_m": null,
        "wavelength_y_m": 0.001,
        "phase_rad": 0
      }
    ],
    "zero_reference": "highest_asperity_at_first_touch",
    "minimum_elements_per_shortest_wavelength": 8,
    "texture_motion": "advect_with_specimen",
    "provenance": "Deterministic synthetic texture; replace with measured surface topography for a named specimen."
  },
  "contact": {
    "friction": {
      "model": "coulomb_exponential_velocity_decay",
      "static_coefficient": 0.6,
      "kinetic_coefficient": 0.45,
      "decay_velocity_m_s": 0.001,
      "coefficient_law": "mu(v) = mu_k + (mu_s - mu_k) * exp(-abs(v) / decay_velocity_m_s)",
      "anisotropy": "isotropic",
      "pair": "specimen_surface_against_shared_sensor_surface"
    },
    "adhesion": {
      "model": "none"
    }
  },
  "status": "implemented_experimental",
  "runnable_with_current_cli": true,
  "parameter_origin": "Illustrative synthetic values; not measured properties of a named commercial material.",
  "material_label": "Textured rough surface",
  "required_capabilities": [
    "moving_textured_contact_surface",
    "surface_mesh_refinement"
  ],
  "model_notes": [
    "The contact coefficients match the rigid reference so the texture change is isolated.",
    "Full contact is assessed over the macroscopic footprint; local asperity gaps are permitted.",
    "Do not replace geometric texture with an increased friction coefficient."
  ],
  "expected_observables": [
    "spatial_pressure_pattern",
    "surface_deformation_texture",
    "tangential_force_n",
    "marker_displacement_m"
  ],
  "calibration_measurements": [
    "surface_height_map_and_resolution",
    "friction_against_sensor_surface"
  ],
  "entry_point": "gelsight-ansys run --config <case.json>"
}
