{
  "config_kind": "material_plane_suite",
  "schema_version": 2,
  "name": "material_plane_force_controlled_5n",
  "status": "implemented_experimental",
  "runnable_with_current_cli": true,
  "calibrated": false,
  "units": "SI",
  "description": "An oversized finite plane compresses the whole nominal sensor footprint, then slides while compression is held. All recorded states must maintain macroscopic contact.",
  "config_contract": {
    "version": "proposed_v1",
    "path_base": "directory_containing_suite_json",
    "composition": "Simulation inputs select object geometry, material case and parameter overrides, surface, and contact; this setup supplies shared sensor, fixture, protocol, and numerics.",
    "current_loader_behavior": "Shared setup only; run a contact_simulation config with run --config. The object geometry selects the mechanical adapter.",
    "sensor_baseline": "The current checkout uses a uniform gel; these configs preserve that baseline and do not restore a separate coating.",
    "unsupported_capability_policy": "reject_before_launch",
    "parameter_policy": "Values are illustrative starting points; numerical validity and real-sensor calibration are separate requirements."
  },
  "sensor": {
    "sensor_model": "gelsight_mini_nominal",
    "calibrated": false,
    "gel": {
      "width_m": 0.02525,
      "length_m": 0.02075,
      "thickness_m": 0.004,
      "elements": [
        36,
        30,
        8
      ]
    },
    "material": {
      "model": "neo_hookean",
      "young_pa": 100000,
      "poisson": 0.49,
      "mooney_fraction": 0.2,
      "formulation": "mixed_up"
    },
    "camera": {
      "width_px": 320,
      "height_px": 240,
      "fov_width_m": 0.0186,
      "fov_height_m": 0.0143,
      "center_x_m": 0,
      "center_y_m": 0,
      "projection": "pinhole",
      "standoff_m": 0.024
    },
    "optics": {
      "backend": "cuda",
      "ambient": 0.12,
      "diffuse": 0.55,
      "specular": 0.08,
      "shininess": 24,
      "gamma": 2.2,
      "light_directions": [
        [
          0.8,
          0,
          0.6
        ],
        [
          -0.4,
          0.692820323,
          0.6
        ],
        [
          -0.4,
          -0.692820323,
          0.6
        ]
      ],
      "light_colors": [
        [
          1,
          0.12,
          0.08
        ],
        [
          0.1,
          1,
          0.15
        ],
        [
          0.12,
          0.16,
          1
        ]
      ],
      "marker_spacing_m": 0.0014,
      "marker_radius_m": 0.0001,
      "marker_opacity": 0.45,
      "background_image": null,
      "animation_fps": 5,
      "marker_style": "material",
      "marker_grid_rows_cols": [
        7,
        9
      ],
      "marker_margin_px": [
        24,
        24
      ],
      "marker_radius_px": 6,
      "model": "taxim",
      "render_mode": "raw",
      "response_gain": 2
    },
    "visualization": {
      "marker_scale": 10,
      "marker_key_um": 100
    }
  },
  "specimen": {
    "geometry": "finite_flat_faced_slab",
    "width_m": 0.06,
    "length_m": 0.035,
    "thickness_m": 0.003,
    "axes": "x=slide, y=transverse, z=out_of_sensor",
    "nominal_first_touch_center_xy_m": [
      0,
      0
    ],
    "fixture": {
      "type": "rigid_platen_on_top_face",
      "coupling": "all_top_face_translations_follow_platen",
      "lateral_faces": "free",
      "bottom_face": "contact_with_sensor",
      "constrained_platen_dofs": [
        "y",
        "rotation_x",
        "rotation_y",
        "rotation_z"
      ]
    },
    "notes": [
      "A finite-thickness layer is required for deformable material behavior; plane describes the nominal contacting face.",
      "The plane must cover the deformed sensor footprint throughout the full x travel."
    ]
  },
  "protocol": {
    "normal_control": "prescribed_normal_force",
    "travel_sign": "positive_toward_sensor",
    "travel_reference": "first_touch_of_highest_specimen_surface_point_with_undeformed_sensor",
    "travel_meaning": "Total approach of specimen backing; includes specimen and gel compression.",
    "initialization": {
      "record_as_dataset_frames": false,
      "start_time_s": -2,
      "end_time_s": 0,
      "start_normal_travel_m": 0,
      "end_normal_travel_m": 0.0001,
      "x_m": 0,
      "y_m": 0,
      "twist_rad": 0,
      "interpolation": "linear",
      "start_contact": "nominal_first_touch",
      "carry_material_and_contact_history_into_recording": true,
      "require_contact_acceptance_before_recording": true
    },
    "recorded_interval_s": [
      0,
      8.0
    ],
    "pose_interpolation": "linear",
    "phases": [
      {
        "name": "press",
        "start_time_s": 0,
        "end_time_s": 2
      },
      {
        "name": "hold_after_press",
        "start_time_s": 2,
        "end_time_s": 3
      },
      {
        "name": "slide_at_fixed_compression",
        "start_time_s": 3,
        "end_time_s": 5,
        "speed_m_s": 0.005
      },
      {
        "name": "hold_after_slide",
        "start_time_s": 5,
        "end_time_s": 6
      },
      {
        "name": "release",
        "start_time_s": 6.0,
        "end_time_s": 8.0
      }
    ],
    "keyframes": [
      {
        "time_s": 0.0,
        "normal_force_n": 1.63,
        "x_m": 0.0,
        "y_m": 0,
        "twist_rad": 0
      },
      {
        "time_s": 0.5,
        "normal_force_n": 2.47,
        "x_m": 0.0,
        "y_m": 0,
        "twist_rad": 0
      },
      {
        "time_s": 1.0,
        "normal_force_n": 3.31,
        "x_m": 0.0,
        "y_m": 0,
        "twist_rad": 0
      },
      {
        "time_s": 1.5,
        "normal_force_n": 4.16,
        "x_m": 0.0,
        "y_m": 0,
        "twist_rad": 0
      },
      {
        "time_s": 2.0,
        "normal_force_n": 5.0,
        "x_m": 0.0,
        "y_m": 0,
        "twist_rad": 0
      },
      {
        "time_s": 3.0,
        "normal_force_n": 5.0,
        "x_m": 0.0,
        "y_m": 0,
        "twist_rad": 0
      },
      {
        "time_s": 3.5,
        "normal_force_n": 5.0,
        "x_m": 0.0025,
        "y_m": 0,
        "twist_rad": 0
      },
      {
        "time_s": 4.0,
        "normal_force_n": 5.0,
        "x_m": 0.005,
        "y_m": 0,
        "twist_rad": 0
      },
      {
        "time_s": 4.5,
        "normal_force_n": 5.0,
        "x_m": 0.0075,
        "y_m": 0,
        "twist_rad": 0
      },
      {
        "time_s": 5.0,
        "normal_force_n": 5.0,
        "x_m": 0.01,
        "y_m": 0,
        "twist_rad": 0
      },
      {
        "time_s": 6.0,
        "normal_force_n": 5.0,
        "x_m": 0.01,
        "y_m": 0,
        "twist_rad": 0,
        "release_travel_m": 0.00029
      },
      {
        "time_s": 7.6,
        "normal_force_n": 0.0,
        "x_m": 0.01,
        "y_m": 0,
        "twist_rad": 0,
        "release_travel_m": 0.0
      },
      {
        "time_s": 8.0,
        "normal_force_n": 0.0,
        "x_m": 0.01,
        "y_m": 0,
        "twist_rad": 0,
        "release_travel_m": -0.0001
      }
    ],
    "release": true,
    "allow_recorded_lift_off": true,
    "notes": [
      "The press commands load directly, so every material reaches 5 N without a per-material travel calibration.",
      "The preload is travel-driven: before first touch a commanded load has no equilibrium position.",
      "The release is travel-driven from release_start_time_s: once the load reaches zero, holding it there cannot express lifting clear.",
      "The first recorded load matches the 1.633 N the 0.10 mm preload reaches, so control changes hands without a step.",
      "Tangential stabilization damping is active because a uniformly loaded, velocity-weakening interface breaks out of stick globally at slide onset, which has no static equilibrium path."
    ],
    "normal_force_target_n": 5.0,
    "travel_calibration": "Not needed: the press commands 5 N directly. The preload stays travel-driven because normal stiffness is zero before first touch, and the release is travel-driven because holding zero load cannot lift clear of the surface.",
    "release_start_time_s": 6.0
  },
  "contact_acceptance": {
    "scope": "all_recorded_frames_and_converged_substeps",
    "definition": "continuous_full_nominal_footprint_at_macroscopic_scale",
    "sensor_region": "whole_outer_sensor_surface_including_area_outside_camera_fov",
    "minimum_geometric_footprint_coverage_fraction": 1,
    "minimum_plane_edge_margin_m": 0.002,
    "use_deformed_sensor_coordinates": true,
    "macroscopic_contact_bins": {
      "size_xy_m": [
        0.001,
        0.001
      ],
      "coordinates": "sensor_material_xy",
      "clip_bins_at_sensor_boundary": true,
      "contact_measure": "positive_repulsive_normal_contact_force_integrated_in_each_bin",
      "minimum_bin_force_n": 1e-06,
      "required_active_bin_fraction": 1
    },
    "minimum_total_repulsive_normal_force_n": 0.01,
    "microscopic_asperity_gaps_allowed": true,
    "tangential_sliding_allowed": true,
    "permanent_bonding": false,
    "full_contact_enforcement": "reject_sequence_if_acceptance_fails; do_not_disable_separation",
    "initial_state_adjustment": "No silent preload increase or contact constraint change; revise the config if preload does not achieve acceptance.",
    "status": "requirements_only_not_verified_by_a_solve"
  },
  "discretization": {
    "gel_base_elements": [
      36,
      30,
      8
    ],
    "deformable_specimen_base_elements": [
      48,
      42,
      6
    ],
    "common_contact_surface_max_edge_m": 0.000125,
    "refined_depth_into_each_deformable_body_m": 0.0005,
    "maximum_element_growth_ratio": 1.3,
    "same_sensor_mesh_for_all_cases": true,
    "required_checks": [
      "surface_resolution",
      "through_thickness_convergence",
      "near_incompressible_locking",
      "contact_coverage"
    ],
    "note": "The default gel uses sensor.gel.elements (36 x 30 x 8). Set gel_mesh to refined to opt into the 0.125 mm whole-surface grid and graded depth. Object mesh resolution is independent. Fine texture accuracy requires a refinement comparison.",
    "object_mesh": {
      "default": "simplified",
      "deformable_max_edge_m": 0.0005,
      "smooth_rigid_target": "single_exact_quad",
      "rough_rigid_target": "retain_resolved_height_geometry",
      "note": "Object discretization is independent of the unchanged gel mesh. Use matched to compare against the original contact-matched solid grid."
    },
    "gel_mesh": "uniform"
  },
  "contact_numerics": {
    "formulation": "augmented_lagrange",
    "sliding": "finite",
    "separation": "allowed",
    "normal_stiffness_factor": 1,
    "tangential_stiffness_factor": 1,
    "penetration_tolerance_m": 1e-06,
    "elastic_slip_tolerance_m": 2.5e-06,
    "update_stiffness_each_iteration": true,
    "retain_history_during_slide": true,
    "stabilization_damping": {
      "normal_factor": 0.001,
      "tangential_factor": 0.001,
      "activation": "always"
    }
  },
  "solver": {
    "version": 252,
    "license_type": "ansys",
    "cores": 2,
    "gpu": true,
    "allow_unlisted_gpu": false,
    "require_gpu": true,
    "initial_substeps": 10,
    "maximum_substeps": 200,
    "iterations": 80,
    "newton_raphson": "unsymmetric",
    "force_tolerance": 0.005,
    "balance_tolerance": 0.02,
    "force_norm": 1,
    "analysis": "time_dependent_quasi_static",
    "large_deflection": true,
    "inertia": false,
    "maximum_time_increment_s": 0.01,
    "gpu_verification": "activation_and_positive_accelerated_work",
    "unsupported_gpu_formulation_policy": "stop_and_report; do_not_silently_change_material_or_formulation"
  },
  "dataset": {
    "sample_interval_s": 0.01,
    "record": [
      "tactile_rgb",
      "surface_displacement_m",
      "marker_positions_px",
      "marker_displacement_m",
      "normal_force_n",
      "tangential_force_n",
      "torque_nm",
      "contact_pressure_pa",
      "repulsive_contact_pressure_pa",
      "contact_status",
      "slip_displacement_m",
      "contact_coverage",
      "platen_travel_m",
      "specimen_deformation_m",
      "time_s"
    ],
    "include_resolved_config": true,
    "include_initialization_history": true,
    "physical_marker_coordinates_unscaled": true,
    "labels": "material_family_and_physical_parameters; no_claim_of_measured_specimen_identity",
    "limitations": [
      "This sequence has no release, so recovery after separation and adhesive pull-off are not observed.",
      "A single x slide cannot identify all anisotropic parameters or all rate dependence.",
      "The fluffy case represents an effective layer; it does not resolve individual fibers.",
      "No vibration channels are claimed by this quasi-static protocol."
    ]
  },
  "required_capabilities": [
    "material_plane_suite_loader",
    "preloaded_initial_state_with_history",
    "finite_plane_full_footprint_contact",
    "time_dependent_quasi_static_steps",
    "velocity_dependent_friction",
    "common_surface_mesh_refinement",
    "contact_coverage_validation"
  ],
  "references": {
    "hyperelastic": "https://ansyshelp.ansys.com/public/Views/Secured/corp/v252/en/ans_mat/aQw8sq22dldm.html",
    "viscoelastic": "https://ansyshelp.ansys.com/public/Views/Secured/corp/v251/en/ans_str/Hlp_G_STR8_3.html",
    "friction": "https://ansyshelp.ansys.com/public/Views/Secured/corp/v252/en/ans_ctec/Hlp_ctec_realkey.html"
  },
  "examples": [
    {
