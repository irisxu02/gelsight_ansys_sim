# Local material-property research atlas
/docs/material-taxonomy/

# Example exports are local datasets; publish only curated documentation assets.
# Ignore future raw-data formats and frame directories by default as well.
/docs/examples/*
!/docs/examples/*.md
!/docs/examples/*/
/docs/examples/*/*
!/docs/examples/*/*.md
!/docs/examples/*/preview.png
!/docs/examples/*/process.gif
!/docs/examples/*/force_curve.png
!/docs/examples/*/raw_vs_subtracted.png
!/docs/examples/*/raw_vs_subtracted.gif
